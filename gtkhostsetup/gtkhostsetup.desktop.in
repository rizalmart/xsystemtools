[Desktop Entry]
_Name=Hostnames
_Comment=Configure the system hostnames
Exec=env SUDO_ASKPASS=/usr/sbin/pysudo sudo -A gtkhostsetup
Icon=gtkhostsetup
Terminal=false
Type=Application
Categories=Application;System;X-XFCE-SettingsDialog;X-XFCE-SystemSettings;
StartupNotify=true
Encoding=UTF-8
NoDisplay=false
NotShowIn=KDE
