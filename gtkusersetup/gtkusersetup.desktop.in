[Desktop Entry]
_Name=Users and Groups
_Comment=Users and groups management tool
Exec=env SUDO_ASKPASS=/usr/sbin/pysudo sudo -A gtkusersetup
Icon=gtkusersetup
Terminal=false
Type=Application
Categories=Application;System;X-XFCE-SettingsDialog;X-XFCE-SystemSettings;
StartupNotify=true
Encoding=UTF-8
NoDisplay=false
NotShowIn=KDE
