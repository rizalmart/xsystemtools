#!/usr/bin/env python3

import os
import sys
import shlex
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Pango


def get_command():
    # Get command supplied by sudo.
    command = os.environ.get("SUDO_COMMAND", "")

    if command:
        try:
            args = shlex.split(command)
            if args:
                return args[0]
        except ValueError:
            pass

    # Fallback: inspect parent sudo process.
    try:
        with open(
            f"/proc/{os.getppid()}/cmdline", "rb"
        ) as f:
            args = f.read().decode(
                errors="replace"
            ).split("\0")

        args = [a for a in args if a]

        if args:
            i = 1

            options_with_args = (
                "-u", "-g", "-h", "-p", "-C",
                "-T", "-R", "-D", "-r", "-t"
            )

            while i < len(args):
                arg = args[i]

                if arg == "--":
                    i += 1
                    break

                if arg in options_with_args:
                    i += 2
                    continue

                if arg.startswith("-") and arg != "-":
                    i += 1
                    continue

                break

            if i < len(args):
                return args[i]

    except (OSError, ValueError):
        pass

    return "Unknown application"


def get_app_icon(executable):
    theme = Gtk.IconTheme.get_default()

    name = os.path.basename(executable)

    candidates = [
        name,
        os.path.splitext(name)[0],
        "application-x-executable",
        "applications-system"
    ]

    for icon in candidates:
        if theme.has_icon(icon):
            return icon

    return "application-x-executable"


class AskPass(Gtk.Dialog):

    def __init__(self):
        super().__init__(
            title="Authentication Required",
            flags=Gtk.DialogFlags.MODAL
        )

        self.set_border_width(16)
        self.set_resizable(False)
        self.set_default_size(380, -1)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("dialog-password")

        # Dialog buttons.
        cancel_button = Gtk.Button.new_with_mnemonic(
            "_Cancel"
        )

        cancel_button.set_image(
            Gtk.Image.new_from_icon_name(
                "process-stop",
                Gtk.IconSize.BUTTON
            )
        )

        cancel_button.set_always_show_image(True)

        auth_button = Gtk.Button.new_with_mnemonic(
            "_Authenticate"
        )

        auth_button.set_image(
            Gtk.Image.new_from_icon_name(
                "dialog-password",
                Gtk.IconSize.BUTTON
            )
        )

        auth_button.set_always_show_image(True)

        self.add_action_widget(
            auth_button,
            Gtk.ResponseType.OK
        )

        self.add_action_widget(
            cancel_button,
            Gtk.ResponseType.CANCEL
        )

        auth_button.get_style_context().add_class(
            "suggested-action"
        )

        self.set_default_response(Gtk.ResponseType.OK)

        executable = get_command()
        basename = os.path.basename(executable)

        content = self.get_content_area()
        content.set_spacing(12)

        # Application information.
        app_box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12
        )

        app_icon = Gtk.Image.new_from_icon_name(
            get_app_icon(executable),
            Gtk.IconSize.DIALOG
        )

        app_icon.set_pixel_size(48)

        app_box.pack_start(
            app_icon,
            False,
            False,
            0
        )

        info = Gtk.Box(
            orientation=Gtk.Orientation.VERTICAL,
            spacing=4
        )

        title = Gtk.Label()
        title.set_markup(
            "<b>Administrator privileges required</b>"
        )
        title.set_xalign(0)

        info.pack_start(
            title,
            False,
            False,
            0
        )

        command_label = Gtk.Label(label=basename)
        command_label.set_xalign(0)

        command_label.set_ellipsize(
            Pango.EllipsizeMode.MIDDLE
        )

        command_label.set_tooltip_text(executable)

        info.pack_start(
            command_label,
            False,
            False,
            0
        )

        app_box.pack_start(
            info,
            True,
            True,
            0
        )

        content.pack_start(
            app_box,
            False,
            False,
            0
        )

        # Separator.
        content.pack_start(
            Gtk.Separator(
                orientation=Gtk.Orientation.HORIZONTAL
            ),
            False,
            False,
            4
        )

        # Password prompt.
        prompt = (
            sys.argv[1]
            if len(sys.argv) > 1
            else "Enter your password:"
        )

        label = Gtk.Label(label=prompt)
        label.set_xalign(0)

        content.pack_start(
            label,
            False,
            False,
            0
        )

        # Password entry.
        self.password = Gtk.Entry()
        self.password.set_visibility(False)

        self.password.set_input_purpose(
            Gtk.InputPurpose.PASSWORD
        )

        self.password.set_activates_default(True)

        content.pack_start(
            self.password,
            False,
            False,
            0
        )

        self.connect(
            "show",
            lambda widget: self.password.grab_focus()
        )

        self.show_all()


def main():
    dialog = AskPass()
    response = dialog.run()

    if response == Gtk.ResponseType.OK:
        password = dialog.password.get_text()

        if password:
            sys.stdout.write(password + "\n")
            sys.stdout.flush()

    # Clear password from the GTK entry.
    dialog.password.set_text("")

    dialog.destroy()

    if response != Gtk.ResponseType.OK:
        sys.exit(1)


if __name__ == "__main__":
    main()
